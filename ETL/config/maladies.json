          "cas_suspects + cas_confirmes_lnr = cas_signalés",
          "deces <= cas_signalés",
          "cas_0_4_ans + cas_5_9_ans + cas_10_14_ans + cas_15_19_ans + cas_20_plus_ans = cas_signalés",
          "cas_masculins + cas_feminins = cas_signalés",
