{
  "covid19": {
    "metadata": {
      "maladie_id": "covid19",
      "nom": "COVID-19",
      "agent_pathogene": "SARS-CoV-2",
      "type": "Pandémique",
      "frequence_donnees": "quotidien",
      "unite_temporelle": "jour",
      "date_premier_cas_madagascar": "2020-03-20",
      "description": "Maladie respiratoire aiguë causée par le coronavirus SARS-CoV-2"
    },
    "source": {
      "nom": "Our World in Data / OMS",
      "fichier_brut": "ETL/covid19/data/raw/covid_24_regions_structured.csv",
      "format": "CSV",
      "encodage": "utf-8",
      "separateur": ",",
      "niveau_initial": "national + régional mélangé",
      "besoin_desagregation": true
    },
    "colonnes_source": {
      "colonnes_utiles": {

        "temporelles": ["date"],
        "geographiques": ["country", "region"],
        "cas": ["new_cases", "total_cases", "new_cases_smoothed", "new_cases_per_million"],
        "gueris": ["new_recoveries", "total_recoveries"],
        "deces": ["new_deaths", "total_deaths", "new_deaths_smoothed", "new_deaths_per_million"],
        "hospitalisations": ["hosp_patients", "hosp_patients_per_million", "weekly_hosp_admissions"],
        "soins_intensifs": ["icu_patients", "icu_patients_per_million", "weekly_icu_admissions"],
        "tests": ["total_tests", "new_tests", "positive_rate", "tests_per_case"],
        "vaccination": ["people_vaccinated", "people_fully_vaccinated", "total_vaccinations"],
        "contexte": ["population", "stringency_index", "reproduction_rate"]
      },
      "colonnes_ignorees": [
        "new_cases_smoothed_per_million",
        "new_deaths_smoothed_per_million",
        "excess_mortality",
        "excess_mortality_cumulative",
        "excess_mortality_cumulative_absolute",
        "excess_mortality_cumulative_per_million",
        "new_tests_smoothed",
        "new_tests_smoothed_per_thousand",
        "total_tests_per_thousand",
        "new_tests_per_thousand",
        "total_vaccinations_per_hundred",
        "people_vaccinated_per_hundred",
        "people_fully_vaccinated_per_hundred",
        "total_boosters",
        "total_boosters_per_hundred",
        "new_vaccinations",
        "new_vaccinations_smoothed",
        "new_vaccinations_smoothed_per_million",
        "new_people_vaccinated_smoothed",
        "new_people_vaccinated_smoothed_per_hundred",
        "code",
        "continent",
        "population_density",
        "median_age",
        "life_expectancy",
        "gdp_per_capita",
        "extreme_poverty",
        "diabetes_prevalence",
        "handwashing_facilities",
        "hospital_beds_per_thousand",
        "human_development_index"
      ],
      "colonne_region_cible": "region"
    },
    "regles_transformation": {
      "semaine_epidemio": {
        "standard": "ISO 8601",
        "format_sortie": "YYYY-Www",
        "exemple": "2020-W12"
      },
      "desagregation_regionale": {
        "methode": "proportionnelle_ponderee",
        "formule": "cas_region = cas_national × (pop_region / pop_nationale) × facteur_ponderation",
        "facteurs_ponderation": {
          "urbain": 1.8,
          "cotier": 1.2,
          "plateau": 1.0,
          "rural": 0.6
        },
        "variabilite_aleatoire": 0.15,
        "description": "Analamanga (urbain) aura ~1.8× plus de cas que sa part démographique"
      },
      "calcul_kpi": {
        "taux_incidence": {
          "formule": "(nouveaux_cas / population_region) * 100000",
          "unite": "pour 100 000 habitants"
        },
        "taux_letalite": {
          "formule": "(deces / cas_totaux) * 100",
          "unite": "pourcentage"
        },
        "taux_hospitalisation": {
          "formule": "(hospitalisations / nouveaux_cas) * 100",
          "unite": "pourcentage"
        }
      },
      "generation_donnees_manquantes": {
        "tranche_age": {
          "methode": "distribution_pyramide_malgache",
          "categories": ["0-9", "10-19", "20-29", "30-39", "40-49", "50-59", "60-69", "70-79", "80+"],
          "probabilites": [0.18, 0.20, 0.17, 0.13, 0.10, 0.08, 0.06, 0.05, 0.03]
        },
        "meteo": {
          "methode": "saisonne_regionale",
          "saison_chaude": {"mois": [11, 12, 1, 2, 3, 4], "temp_base": 28, "humidite_base": 75},
          "saison_seche": {"mois": [5, 6, 7, 8, 9, 10], "temp_base": 22, "humidite_base": 55}
        }
      }
    }
  },

  "paludisme": {
    "metadata": {
      "maladie_id": "paludisme",
      "nom": "Paludisme",
      "agent_pathogene": "Plasmodium falciparum (majoritaire à Madagascar)",
      "type": "Endémique",
      "frequence_donnees": "hebdomadaire",
      "unite_temporelle": "semaine",
      "saisonnalite": "Novembre à Avril (saison des pluies)",
      "populations_vulnerables": ["enfants_moins_5_ans", "femmes_enceintes"],
      "description": "Maladie parasitaire transmise par les moustiques Anophèles, endémique à Madagascar"
    },
    "source": {
      "nom": "PNLP Madagascar / Institut Pasteur de Madagascar",
      "fichier_brut": "ETL/paludisme/data/processed/paludisme_madagascar_enrichi.csv",
      "format": "CSV",
      "encodage": "utf-8",
      "separateur": ",",
      "niveau_initial": "régional (déjà désagrégé)",
      "besoin_desagregation": false
    },
    "colonnes_source": {
      "colonnes_utiles": {
        "temporelles": ["date", "annee", "mois", "semaine_epidemio"],
        "geographiques": ["region", "latitude_region", "longitude_region", "type_zone"],
        "demographiques": ["population_region", "population_moins_5_ans", "population_femmes_enceintes"],
        "cas": ["cas_suspects", "cas_confirmes", "cas_graves", "cas_enfants_moins_5_ans", "cas_femmes_enceintes"],
        "deces": ["deces", "deces_enfants_moins_5_ans"],
        "gueris":["new_recoveries", "total_recoveries"],
        "specifiques_paludisme": [
          "type_plasmodium",
          "tests_rapides_realises",
          "traitements_CTA_administres"
        ],
        "contexte": [
          "temperature",
          "humidite",
          "precipitation",
          "saison",
          "acces_soins",
          "tranche_age"
        ],
        "kpis_deja_calcules": [
          "taux_incidence",
          "taux_letalite",
          "taux_positivite",
          "incidence_enfants_5_ans",
          "proportion_grave",
          "niveau_alerte"
        ]
      },
      "colonnes_ignorees": [],
      "colonne_region_cible": "region"
    },
    "regles_transformation": {
      "semaine_epidemio": {
        "standard": "ISO 8601",
        "format_sortie": "YYYY-Www",
        "exemple": "2024-W12",
        "description": "Déjà calculée dans le fichier source"
      },
      "desagregation_regionale": {
        "methode": "aucune",
        "description": "Les données sont déjà au niveau régional"
      },
      "calcul_kpi": {
        "taux_incidence": {
          "formule": "(cas_confirmes / population_region) * 1000",
          "unite": "pour 1 000 habitants / semaine",
          "description": "Déjà calculé dans le fichier source"
        },
        "taux_letalite": {
          "formule": "(deces / cas_confirmes) * 100",
          "unite": "pourcentage",
          "description": "Déjà calculé dans le fichier source"
        },
        "taux_positivite": {
          "formule": "(cas_confirmes / tests_rapides_realises) * 100",
          "unite": "pourcentage",
          "description": "Déjà calculé dans le fichier source"
        },
        "incidence_enfants_5_ans": {
          "formule": "(cas_enfants_moins_5_ans / population_moins_5_ans) * 1000",
          "unite": "pour 1 000 enfants < 5 ans",
          "description": "Déjà calculé dans le fichier source"
        },
        "proportion_grave": {
          "formule": "(cas_graves / cas_confirmes) * 100",
          "unite": "pourcentage",
          "description": "Déjà calculé dans le fichier source"
        }
      },
      "generation_donnees_manquantes": {
        "meteo": {
          "methode": "deja_presente",
          "description": "Température, humidité et précipitations déjà générées"
        },
        "tranche_age": {
          "methode": "deja_presente",
          "description": "Distribution spécifique paludisme déjà appliquée"
        }
      },
      "validation": {
        "regles_coherence": [
          "cas_confirmes <= cas_suspects",
          "deces <= cas_confirmes",
          "cas_graves <= cas_confirmes",
          "deces_enfants_moins_5_ans <= deces",
          "taux_letalite entre 0 et 100",
          "taux_positivite entre 0 et 100",
          "population_moins_5_ans = population_region * 0.15",
          "population_femmes_enceintes = population_region * 0.03"
        ]
      }
    },
    "seuils_alerte": {
      "indicateur_principal": "taux_incidence",
      "unite": "pour 1 000 habitants / semaine",
      "niveaux": {
        "Vert": {"min": 0, "max": 10, "couleur": "#10b981", "signification": "Situation maîtrisée"},
        "Jaune": {"min": 10, "max": 30, "couleur": "#f59e0b", "signification": "Circulation modérée"},
        "Orange": {"min": 30, "max": 60, "couleur": "#f97316", "signification": "Circulation active"},
        "Rouge": {"min": 60, "max": null, "couleur": "#ef4444", "signification": "Épidémie active"}
      },
      "regles_speciales": {
        "alerte_enfants": {
          "condition": "incidence_enfants_5_ans > 50",
          "action": "Escalader d'un niveau d'alerte",
          "description": "Protection renforcée des enfants < 5 ans"
        },
        "saisonnalite": {
          "periode_risque": "Novembre à Avril",
          "facteur_multiplicateur": 3.5,
          "description": "Surveillance renforcée pendant la saison des pluies"
        }
      }
    }
  },

