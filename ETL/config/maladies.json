    },
    "source": {
      "nom": "Données simulées / IPM-LNR / Ministère Santé / Institut Pasteur de Madagascar",
      "fichier_brut": "ETL/rougeole/data/raw/rougeole_madagascar_raw.csv",
      "format": "CSV",
      "encodage": "utf-8",
      "separateur": ",",
      "niveau_initial": "régional",
      "besoin_desagregation": false
    },
    "colonnes_source": {
      "colonnes_utiles": {
        "temporelles": ["date", "annee", "mois", "semaine_epidemio"],
        "geographiques": ["region", "latitude_region", "longitude_region"],
        "demographiques": ["population_region", "population_cible_vaccination"],
        "cas": ["cas_signalés", "cas_suspects", "cas_confirmes_lnr", "deces"],
        "gueris": ["new_recoveries", "total_recoveries"],
        "age": ["cas_0_4_ans", "cas_5_9_ans", "cas_10_14_ans", "cas_15_19_ans", "cas_20_plus_ans"],
        "sexe": ["cas_masculins", "cas_feminins"],
        "vaccination": ["cas_non_vaccines", "cas_statut_inconnu", "cas_1_dose", "cas_2_doses", "enfants_vaccines_1_dose", "enfants_vaccines_2_doses", "couverture_vaccinale_pct"],
        "periode": ["periode_epidemique"]
      },
      "colonnes_ignorees": [],
      "colonne_region_cible": "region"
    },
    "regles_transformation": {
      "semaine_epidemio": {
        "standard": "ISO 8601",
        "format_sortie": "YYYY-Www",
        "description": "Déjà calculée dans le fichier source"
      },
      "desagregation_regionale": {
        "methode": "aucune",
        "description": "Données déjà au niveau régional"
      },
      "calcul_kpi": {
        "taux_incidence": {
          "formule": "(cas_signalés / population_region) * 100000",
          "unite": "pour 100 000 habitants"
        },
