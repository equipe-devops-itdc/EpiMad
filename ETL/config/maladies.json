  },

  "source": {
    "nom": "OMS / Ministère de la Santé / Institut Pasteur de Madagascar",
    "fichier_brut": "ETL/hepatite/data/raw/hepatite_madagascar_raw.csv",
    "format": "CSV",
    "encodage": "utf-8",
    "separateur": ",",
    "niveau_initial": "regional",
    "besoin_desagregation": false,
    "type_donnees": "synthetiques_calibrees",
    "remarque": "Les données régionales 2020-2025 générées pour EpiMad sont simulées et calibrées à partir des références épidémiologiques disponibles."
  },

  "colonnes_source": {
    "colonnes_utiles": {
      "temporelles": [
        "date",
        "annee",
        "mois",
        "semaine_epidemio"
      ],

      "geographiques": [
        "region",
        "latitude_region",
        "longitude_region"
      ],

      "demographiques": [
        "population_region",
        "femmes_enceintes",
        "enfants_moins_5_ans",
        "naissances_semaine",
        "porteurs_chroniques_estimes",
        "prevalence_aghbs_region"
      ],

      "depistage_femmes_enceintes": [
        "femmes_enceintes_depistees",
        "femmes_enceintes_aghbs_positives"
      ],

      "transmission_mere_enfant": [
        "enfants_exposes_aghbs",
        "enfants_vaccines_naissance",
        "enfants_devenus_porteurs",
        "taux_transmission_mere_enfant",
        "couverture_vaccinale_naissance"
      ],

      "age_chroniques": [
        "cas_chroniques_enfants",
        "cas_chroniques_adultes",
        "cas_chroniques_seniors"
      ],

      "cas": ["cas_aigus", "nouveaux_diagnostics_aghbs", "cas_chroniques_suivis"],
      "deces": ["deces"],
      "gueris": ["new_recoveries", "total_recoveries"],

      "depistage_traitement": [
        "tests_depistage",
        "nouveaux_diagnostics_aghbs",
        "personnes_traitees"
      ]
    },

    "colonnes_ignorees": [],

    "colonne_region_cible": "region"
  },

  "regles_transformation": {

    "semaine_epidemio": {
      "standard": "ISO 8601",
      "format_sortie": "YYYY-Www",
      "description": "Semaine épidémiologique calculée à partir de la date."
    },

    "desagregation_regionale": {
      "methode": "aucune",
      "description": "Les données sont générées ou disponibles directement au niveau régional."
    },

    "calcul_indicateurs": {

      "prevalence_aghbs": {
        "formule": "porteurs_chroniques_estimes / population_region",
        "unite": "proportion"
      },

      "prevalence_aghbs_pourcentage": {
        "formule": "(porteurs_chroniques_estimes / population_region) * 100",
        "unite": "pourcentage"
      },

      "taux_incidence": {
        "formule": "(nouveaux_diagnostics_aghbs / population_region) * 100000",
        "unite": "pour 100 000 habitants",
        "description": "Nombre de nouveaux diagnostics rapporté à la population régionale."
      },

      "taux_letalite": {
        "formule": "(deces / (cas_aigus + nouveaux_diagnostics_aghbs)) * 100",
        "unite": "pourcentage"
      },

      "taux_depistage": {
        "formule": "(tests_depistage / population_region) * 100",
        "unite": "pourcentage"
      },

      "taux_positivite_aghbs": {
        "formule": "(femmes_enceintes_aghbs_positives / femmes_enceintes_depistees) * 100",
        "unite": "pourcentage"
      },

      "taux_couverture_vaccinale": {
        "formule": "(enfants_vaccines_naissance / naissances_semaine) * 100",
        "unite": "pourcentage"
      }
    },

    "validation": {
      "regles_coherence": [
        "population_region > 0",
        "cas_aigus >= 0",
        "nouveaux_diagnostics_aghbs >= 0",
        "cas_chroniques_suivis >= 0",
        "deces >= 0",
        "deces <= cas_aigus",
        "prevalence_aghbs_region >= 0",
        "prevalence_aghbs_region <= 0.30",
        "femmes_enceintes_depistees <= femmes_enceintes",
        "femmes_enceintes_aghbs_positives <= femmes_enceintes_depistees",
        "enfants_vaccines_naissance <= naissances_semaine",
        "enfants_devenus_porteurs <= enfants_exposes_aghbs",
        "taux_transmission_mere_enfant >= 0",
        "taux_transmission_mere_enfant <= 100",
        "couverture_vaccinale_naissance >= 0",
