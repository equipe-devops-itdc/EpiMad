  "rougeole": {
    "metadata": {
      "maladie_id": "rougeole",
      "nom": "Rougeole",
      "agent_pathogene": "Virus de la rougeole (Paramyxoviridae)",
      "type": "Endémique avec épidémies",
      "frequence_donnees": "hebdomadaire",
      "unite_temporelle": "semaine",
      "population_cible": "Enfants de 9 mois à 5 ans",
